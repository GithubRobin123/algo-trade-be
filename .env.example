# ================================================================
# Copy this to .env and fill in your values (never commit .env)
# ================================================================

NODE_ENV=production
PORT=4000

# Vercel frontend URL (set after Vercel deployment)
FRONTEND_URL=https://YOUR-APP.vercel.app

# Supabase PostgreSQL connection string (from Supabase → Settings → Database)
DATABASE_URL=postgres://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DB_LOGGING=false

# Upstox app credentials (from developer.upstox.com)
UPSTOX_API_BASE_URL=https://api.upstox.com
UPSTOX_CLIENT_ID=your_client_id
UPSTOX_CLIENT_SECRET=your_client_secret
# Set this to your Render backend URL after deployment
UPSTOX_REDIRECT_URI=https://YOUR-RENDER-APP.onrender.com/api/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_ACCESS_TOKEN_EXPIRES_AT=

# Daily token without OTP: Upstox "Access Token Request" (tap Approve in the Upstox app / WhatsApp).
# Set the Notifier Webhook URL of your Upstox app to https://<backend>/api/auth/upstox/callback
UPSTOX_AUTO_TOKEN_REQUEST=true
UPSTOX_TOKEN_REQUEST_TIME_IST=08:30
UPSTOX_TOKEN_REQUEST_RETRY_MINUTES=20
UPSTOX_TOKEN_REQUEST_MAX_ATTEMPTS=3
# Your Upstox UCC (recommended): webhook tokens for any other account are rejected
UPSTOX_USER_ID=

# false = API only (no polling / strategy / execution monitor / token requests).
# Set false on any second instance (e.g. local) that points at the production database.
BACKGROUND_JOBS_ENABLED=true

NIFTY_INSTRUMENT_KEY=NSE_INDEX|Nifty 50
OPTION_CHAIN_INSTRUMENT_KEY=NSE_INDEX|Nifty 50
OPTION_CHAIN_EXPIRY_DATE=
OPTION_CHAIN_REFRESH_MS=30000
MARKET_POLL_INTERVAL_MS=5000
# Real-time ticks over the Upstox WebSocket (2 connections per user; each backend uses 1).
# false = REST polling only, e.g. on an extra instance to keep a connection free.
UPSTOX_STREAM_ENABLED=true
MARKET_HISTORY_LIMIT=500

SUPPORTED_UNDERLYINGS_JSON=
DEFAULT_UNDERLYING_SYMBOL=NIFTY

STRATEGY_ENABLED=true
STRATEGY_SCAN_INTERVAL_MS=20000
STRATEGY_MAX_AUTO_TRADES_PER_DAY=5
STRATEGY_DAILY_MAX_LOSS_PCT=3
STRATEGY_CAPITAL=100000
STRATEGY_ENTRY_STOP_LOSS_PCT=10
STRATEGY_PROFIT_TARGET_PCT=40
STRATEGY_TRAIL_ACTIVATION_PCT=20
STRATEGY_TRAIL_OFFSET_PCT=6
STRATEGY_CONFIDENCE_THRESHOLD=0.68
STRATEGY_RULES_GATE_ENABLED=true
STRATEGY_SL_ATR_MULTIPLIER=1.5
STRATEGY_SL_MIN_PCT=10
STRATEGY_SL_MAX_PCT=30
STRATEGY_TRAIL_ATR_MULTIPLIER=1.5
STRATEGY_WARMUP_SESSIONS=2
INTENT_EXPIRY_MINUTES=2

REQUIRE_TRADE_APPROVAL=false
ENABLE_LIVE_ORDERS=false
DEFAULT_ORDER_PRODUCT=D
DEFAULT_ORDER_VALIDITY=DAY

AI_ENABLED=true
AI_PROVIDER=none
AI_API_KEY=
AI_TIMEOUT_MS=6000
AI_MIN_PROBABILITY_PCT=70

INDIA_VIX_OVERRIDE=14
